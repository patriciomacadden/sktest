<% content_for :title, "Posts" %>

<% if @posts.any? %>
  <ol class="post-list">
    <% @posts.each do |post| %>
      <li>
        <h2 class="post-list__title"><%= link_to post.title, post_path(post) %></h2>
        <% if post.url.present? %>
          <span class="post-url">(<%= link_to URI.parse(post.url).host, post.url %>)</span>
        <% end %>

        <p class="post-meta"><%= pluralize(post.comments_count, "comment") %> · By <%= post.author.email_address %> · <time datetime="<%= post.created_at.iso8601 %>"><%= post.created_at.to_fs(:long) %></time></p>

        <% if authenticated? && post.editable_by?(Current.user) %>
          <div class="post-actions"><%= link_to "Edit", edit_post_path(post) %> · <%= button_to "Delete", post_path(post), method: :delete %></div>
        <% end %>
      </li>
    <% end %>
  </ol>
<% elsif authenticated? %>
  <p>There are no posts yet. <%= link_to "Create the first post", new_post_path %>.</p>
<% else %>
  <p>There are no posts yet. <%= link_to "Sign in to create the first post", new_session_path %>.</p>
<% end %>
