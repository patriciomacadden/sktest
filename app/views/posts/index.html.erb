<% content_for :title, "Posts" %>

<h1>Posts</h1>

<%= render "application/account_controls" %>

<% if authenticated? %>
  <p><%= link_to "Create post", new_post_path %></p>
<% end %>

<% if @posts.any? %>
  <% @posts.each do |post| %>
    <article>
      <h2><%= post.title %></h2>

      <% if post.url.present? %>
        <p><%= link_to post.url, post.url %></p>
      <% end %>

      <% if post.body.present? %>
        <%= simple_format(h(post.body), sanitize: false) %>
      <% end %>

      <p>By <%= post.author.email_address %> on <time datetime="<%= post.created_at.iso8601 %>"><%= post.created_at.to_fs(:long) %></time></p>

      <% if authenticated? && post.editable_by?(Current.user) %>
        <p>
          <%= link_to "Edit", edit_post_path(post) %>
          <%= button_to "Delete", post_path(post), method: :delete %>
        </p>
      <% end %>
    </article>
  <% end %>
<% elsif authenticated? %>
  <p>There are no posts yet. <%= link_to "Create the first post", new_post_path %>.</p>
<% else %>
  <p>There are no posts yet. <%= link_to "Sign in to create the first post", new_session_path %>.</p>
<% end %>
