<% content_for :title, "Posts · Threadwell" %>

<section class="post-list">
  <% @posts.each do |post| %>
    <article class="post-row">
      <div class="score">▲<strong><%= post.votes_count %></strong>votes</div>
      <div>
        <div class="post-title"><%= link_to post.title, post %> <% if post.link_url %><span class="domain">(<%= URI.parse(post.link_url).host %>)</span><% end %></div>
        <div class="metadata">by <%= post.author.email_address %> · <%= time_tag post.created_at, post.created_at.strftime("%b %-d, %Y") %> · <%= pluralize(post.comments_count, "comment") %></div>
      </div>
    </article>
  <% end %>

  <% if @posts.empty? %>
    <p class="empty-state">Nothing here yet. <%= authenticated? ? link_to("Start a post", new_post_path) : link_to("Join to start a post", new_registration_path) %>.</p>
  <% end %>
</section>
