<% if local_assigns[:compact] %>
  <li class="app-post-list__item">
<% end %>

<article class="app-post">
  <h2 class="app-post__title">
    <%= link_to post.title, post_path(post) %>
    <% if local_assigns[:compact] && (original_url = safe_original_url(post)) %>
      <span class="app-post__domain">(<%= link_to original_url_domain(post), original_url %>)</span>
    <% end %>
  </h2>
  <p class="app-post__metadata">
    By <%= post.author.email_address %> ·
    <%= time_tag post.created_at, post.created_at.to_fs(:long) %>
  </p>
  <%= tag.p(post.body, class: "app-post__body") if post.body.present? %>
  <% if !local_assigns[:compact] && (original_url = safe_original_url(post)) %>
    <%= tag.p(link_to("Original URL", original_url)) %>
  <% end %>

  <% if local_assigns[:manage] %>
    <div class="app-post__actions">
      <%= link_to "Edit post", edit_my_post_path(post) %>
      <%= button_to "Delete post", my_post_path(post), method: :delete %>
    </div>
  <% end %>
</article>

<% if local_assigns[:compact] %>
  </li>
<% end %>
