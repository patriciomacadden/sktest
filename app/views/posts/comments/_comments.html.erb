<section id="comments" class="comments" aria-label="Discussion">
  <% if authenticated? && reply_parent_id.nil? %>
    <%= render "posts/comments/form", post: post, comment: comment %>
  <% elsif !authenticated? %>
    <p><%= link_to "Sign in to comment", new_session_path %></p>
  <% end %>
  <% if thread.none? %>
    <p>No comments yet.</p>
  <% else %>
    <ol class="comment-thread" aria-label="Post comments">
      <% thread.each do |thread_comment, depth| %>
        <%= render "posts/comments/comment", post: post, comment: thread_comment, depth: depth, focus: focus_comment_id.to_s == thread_comment.id.to_s, replying: reply_parent_id.to_s == thread_comment.id.to_s %>
        <% if reply_parent_id.to_s == thread_comment.id.to_s %>
          <li class="comment comment--composer" style="--comment-depth: <%= [depth + 1, 6].min %>">
            <%= render "posts/comments/form", post: post, comment: comment %>
          </li>
        <% end %>
      <% end %>
    </ol>
  <% end %>
</section>
