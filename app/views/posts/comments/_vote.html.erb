<% vote_label = voted ? "Remove your vote" : "Vote for this comment" %>
<% vote_label = "#{vote_label}. #{pluralize(comment.votes_count, "vote")}." %>

<div class="comment-vote">
  <% if authenticated? %>
    <%= button_to "▲", post_comment_vote_path(post, comment), method: voted ? :delete : :post, class: class_names("app-post__vote", "app-post__vote--voted": voted), form_class: "app-post__vote-form", aria: { label: vote_label, pressed: voted } %>
  <% else %>
    <%= link_to "▲", new_session_path, class: "app-post__vote", aria: { label: "Sign in to vote for this comment. #{pluralize(comment.votes_count, "vote")}." } %>
  <% end %>
  <span class="comment-vote__total"><%= pluralize(comment.votes_count, "vote") %></span>
</div>
