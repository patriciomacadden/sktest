<% content_for :title, @post.title %>

<article class="post-detail">
  <div class="post-detail__header">
    <%= render "upvotes/tally", target: @post, post: @post, upvoted: @upvoted_post_ids.include?(@post.id) %>
    <div>
      <h1 class="post-detail__title"><%= @post.title %></h1>
      <% if @post.url.present? %>
        <span class="post-url">(<%= link_to URI.parse(@post.url).host, @post.url %>)</span>
      <% end %>

      <p class="post-meta">By <%= @post.author.email_address %> · <time datetime="<%= @post.created_at.iso8601 %>"><%= @post.created_at.to_fs(:long) %></time></p>
    </div>
  </div>

  <% if @post.body.present? %>
    <div class="post-detail__body"><%= simple_format(h(@post.body), sanitize: false) %></div>
  <% end %>
</article>

<section class="comments" aria-labelledby="comments-heading">
  <h2 id="comments-heading">Comments <span class="post-meta">(<%= @post.comments_count %>)</span></h2>

  <% if @comments_by_parent_id[nil].present? %>
    <ol class="comment-thread">
      <% @comments_by_parent_id[nil].each do |comment| %>
        <li><%= render "comments/comment", comment:, post: @post, comments_by_parent_id: @comments_by_parent_id, upvoted_comment_ids: @upvoted_comment_ids, editing: false %></li>
      <% end %>
    </ol>
  <% elsif authenticated? %>
    <p>There are no comments yet. Add the first comment.</p>
  <% else %>
    <p>There are no comments yet. <%= link_to "Sign in to add the first comment", new_session_path %>.</p>
  <% end %>

  <% if authenticated? %>
    <div class="form-panel">
      <h3>Add a comment</h3>
      <%= render "comments/form", comment: @comment, post: @post, submit_label: "Add comment" %>
    </div>
  <% else %>
    <p><%= link_to "Sign in to add a comment", new_session_path %>.</p>
  <% end %>
</section>
