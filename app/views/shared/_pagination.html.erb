<% if page > 1 || has_next_page %>
  <nav class="app-pagination" aria-label="<%= label %> pagination">
    <% if page > 1 %>
      <%= link_to "Previous", url_for(page: page - 1) %>
    <% end %>
    <span aria-current="page">Page <%= page %></span>
    <% if has_next_page %>
      <%= link_to "Next", url_for(page: page + 1) %>
    <% end %>
  </nav>
<% end %>
