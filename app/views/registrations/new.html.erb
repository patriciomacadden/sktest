<% content_for :body_class, "app-page app-page--registration" %>

<div class="app-shell app-shell--registration">
  <main class="app-main">
    <h1>Sign up</h1>

  <% if @user.errors.any? %>
    <div class="app-form-errors" role="alert">
      <h2>Check your details</h2>
      <ul>
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, url: registration_path, class: "app-form" do |form| %>
    <p>
      <%= form.label :email_address, "Email address" %><br>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email" %>
    </p>
    <p>
      <%= form.label :password, "Password" %><br>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %>
    </p>
    <p>
      <%= form.label :password_confirmation, "Confirm password" %><br>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
    </p>
    <%= form.submit "Sign up", class: "app-primary-action" %>
  <% end %>

    <p class="app-secondary-links"><%= link_to "Sign in", new_session_path %></p>
  </main>
</div>
