<div class="auth-page">
  <h1>Sign in</h1>

  <% if flash[:alert] %>
    <p class="alert" role="alert"><%= flash[:alert] %></p>
  <% end %>
  <% if flash[:notice] %>
    <p class="notice"><%= flash[:notice] %></p>
  <% end %>

  <div class="form-panel">
    <%= form_with url: session_path do |form| %>
      <div class="form-field">
        <%= form.label :email_address, "Email address" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
      </div>

      <div class="form-field">
        <%= form.label :password %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>
      </div>

      <div class="form-actions"><%= form.submit "Sign in" %></div>
    <% end %>
  </div>

  <p><%= link_to "Forgot password?", new_password_path %></p>
  <p>New here? <%= link_to "Create account", new_registration_path %>.</p>
</div>
