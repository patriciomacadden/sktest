<% content_for :body_class, "app-page app-page--session" %>

<div class="app-shell app-shell--session">
  <main class="app-main">
    <h1>Sign in</h1>

    <%= tag.p(flash[:alert], class: "app-alert", role: "alert") if flash[:alert] %>
    <%= tag.p(flash[:notice], class: "app-alert", role: "status") if flash[:notice] %>

    <%= form_with url: session_path, class: "app-form" do |form| %>
    <p>
      <%= form.label :email_address, "Email address" %><br>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
    </p>
    <p>
      <%= form.label :password, "Password" %><br>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>
    </p>
      <%= form.submit "Sign in", class: "app-primary-action" %>
  <% end %>

    <div class="app-secondary-links">
      <%= link_to "Reset password", new_password_path %>
      <%= link_to "Sign up", new_registration_path %>
    </div>
  </main>
</div>
