<% content_for :title, "Sign in · Threadwell" %>
<h1>Sign in</h1>
<%= form_with url: session_path, class: "stacked-form" do |form| %>
  <%= form.label :email %><%= form.email_field :email, autofocus: true, required: true %>
  <%= form.label :password %><%= form.password_field :password, required: true %>
  <%= form.submit "Sign in" %>
<% end %>
<p><%= link_to "Forgot your password?", new_password_path %></p>
