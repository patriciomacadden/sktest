<main>
  <h1>Sign in</h1>

  <%= tag.p(flash[:alert], role: "alert") if flash[:alert] %>
  <%= tag.p(flash[:notice], role: "status") if flash[:notice] %>

  <%= form_with url: session_path do |form| %>
    <p>
      <%= form.label :email_address, "Email address" %><br>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
    </p>
    <p>
      <%= form.label :password, "Password" %><br>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>
    </p>
    <%= form.submit "Sign in" %>
  <% end %>

  <p><%= link_to "Reset password", new_password_path %></p>
  <p><%= link_to "Sign up", new_registration_path %></p>
</main>
