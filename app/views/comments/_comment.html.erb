<%= turbo_frame_tag dom_id(comment, :editor) do %>
  <article id="<%= dom_id comment %>" class="comment">
    <p class="comment-meta">By <%= comment.author.email_address %> · <time datetime="<%= comment.created_at.iso8601 %>"><%= comment.created_at.to_fs(:long) %></time><%= " (edited)" if comment.edited? %></p>

    <% if editing %>
      <div class="form-panel">
        <%= render "comments/form", comment:, post:, submit_label: "Save changes" %>
      </div>
      <p class="comment-actions"><%= link_to "Cancel", post_path(post, anchor: dom_id(comment)) %></p>
    <% else %>
      <%= simple_format(h(comment.deleted? ? "[deleted]" : comment.body), sanitize: false) %>

      <% if authenticated? && comment.editable_by?(Current.user) %>
        <p class="comment-actions"><%= link_to "Edit", edit_post_comment_path(post, comment) %></p>
      <% end %>

      <% if authenticated? && comment.deletable_by?(Current.user) %>
        <%= button_to "Delete", post_comment_path(post, comment), method: :delete %>
      <% end %>
    <% end %>

    <% if comment.replyable? %>
      <% if authenticated? %>
        <details>
          <summary>Reply</summary>
          <div class="form-panel">
            <%= render "comments/form", comment: Comment.new(post:, parent: comment), post:, submit_label: "Reply" %>
          </div>
        </details>
      <% else %>
        <p><%= link_to "Sign in to reply", new_session_path %>.</p>
      <% end %>
    <% end %>

    <% if comments_by_parent_id[comment.id].present? %>
      <ol class="comment-replies">
        <% comments_by_parent_id[comment.id].each do |reply| %>
          <li><%= render "comments/comment", comment: reply, post:, comments_by_parent_id:, editing: false %></li>
        <% end %>
      </ol>
    <% end %>
  </article>
<% end %>
