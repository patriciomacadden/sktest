<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Threadwell" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <div class="topline"></div>
    <header class="site-header">
      <%= link_to root_path, class: "brand" do %>thread<span>well</span><% end %>
      <nav><%= link_to "Posts", root_path %></nav>
      <div class="account-nav">
        <% if authenticated? %>
          <%= link_to "New post", new_post_path, class: "join" %>
          <span><%= Current.user.email_address %></span>
          <%= button_to "Sign out", session_path, method: :delete, class: "text-button" %>
        <% else %>
          <%= link_to "Sign in", new_session_path %>
          <%= link_to "Join", new_registration_path, class: "join" %>
        <% end %>
      </div>
    </header>
    <main class="page-content">
      <% if notice %><p class="flash notice"><%= notice %></p><% end %>
      <% if alert %><p class="flash alert"><%= alert %></p><% end %>
      <%= yield %>
    </main>
    <footer>Threadwell · public conversations, kept small.</footer>
  </body>
</html>
