<main>
  <% if authenticated? %>
    <h1>Signed in as <%= current_user.email_address %></h1>
    <p><%= link_to "Posts", posts_path %></p>
    <p><%= link_to "My posts", my_posts_path %></p>
    <p><%= link_to "Create post", new_my_post_path %></p>
    <%= button_to "Sign out", session_path, method: :delete %>
  <% else %>
    <h1>Welcome</h1>
    <p><%= link_to "Posts", posts_path %></p>
    <p><%= link_to "Sign up", new_registration_path %></p>
    <p><%= link_to "Sign in", new_session_path %></p>
  <% end %>
</main>
